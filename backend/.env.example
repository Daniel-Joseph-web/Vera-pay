# Verapay Backend Environment Variables
PORT=4000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://verapay_user:verapay_password@localhost:5432/verapay_db?schema=public"

# AI Engine
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# Inbound Payment Rails (PayPal Sandbox)
PAYPAL_CLIENT_ID="your_paypal_sandbox_client_id"
PAYPAL_CLIENT_SECRET="your_paypal_sandbox_client_secret"
PAYPAL_API_URL="https://api-m.sandbox.paypal.com"
PAYPAL_WEBHOOK_ID="your_paypal_webhook_id"

# Outbound Payout Rails (Paystack / Flutterwave)
PAYSTACK_SECRET_KEY="sk_test_your_paystack_secret_key"
PAYSTACK_PUBLIC_KEY="pk_test_your_paystack_public_key"

# Storage / S3 (For evidence media)
STORAGE_BUCKET_NAME="verapay-evidence-vault"
AWS_ACCESS_KEY_ID="your_aws_key"
AWS_SECRET_ACCESS_KEY="your_aws_secret"
AWS_REGION="eu-west-1"

# Client URL (CORS)
CLIENT_URL="http://localhost:3000"
